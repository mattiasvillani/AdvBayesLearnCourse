\begin_deeper
\begin_layout Itemize
If 
\begin_inset Formula $P\sim\mathrm{DP}(\alpha_{0}P_{0})$
\end_inset

 then
\begin_inset Formula 
\[
P(B)\sim\mathrm{Beta}\left[\alpha_{0}P_{0}(B),\alpha_{0}\left(1-P_{0}(B)\right)\right],\;\text{for any }B\in\mathcal{B}
\]

\end_inset


\begin_inset Formula 
\[
\mathbb{E}\left[P(B)\right]=P_{0}(B)
\]

\end_inset


\begin_inset Formula 
\[
\mathrm{\mathbb{V}}\left[P(B)\right]=P_{0}(B)\left[1-P_{0}(B)\right]/(1+\alpha_{0})
\]

\end_inset


\end_layout


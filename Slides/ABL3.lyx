Posterior
\series default
\color inherit
 for the unknown probability distribution 
\begin_inset Formula $P$
\end_inset


\begin_inset Formula 
\[
P|y_{1},...,y_{n}\sim\mathrm{DP}\left(\alpha_{0}P_{0}+\sum_{i=1}^{n}\delta_{y_{i}}\right)
\]

\end_inset


\end_layout

\begin_layout Itemize
Since 
\begin_inset Formula 
\[
P(B)\sim\mathrm{Beta}\left(\alpha_{0}P_{0}(B)+\sum_{i=1}^{n}1_{y_{i}\in B},\alpha_{0}(1-P_{0}(B))+\sum_{i=1}^{n}1_{y_{i}\in B^{c}}\right)
\]

\end_inset

so
\begin_inset Formula 
\[
\mathbb{E}\left(P(B)|y_{1},...,y_{n}\right)=\left(\frac{\alpha_{0}}{\alpha_{0}+n}\right)P_{0}(B)+\left(\frac{n}{\alpha_{0}+n}\right)\sum_{i=1}^{n}\frac{1}{n}\delta_{y_{i}}(B)
\]

\end_inset


\end_layout

\end_deeper

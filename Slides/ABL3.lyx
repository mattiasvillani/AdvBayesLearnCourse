\begin_deeper
\begin_layout Itemize
If 
\begin_inset Formula $B=(-\infty,y]$
\end_inset

 then
\begin_inset Formula 
\[
E\left(F(y)|y_{1},...,y_{n}\right)=\left(\frac{\alpha_{0}}{\alpha_{0}+n}\right)F_{0}(y)+\left(\frac{n}{\alpha_{0}+n}\right)F_{n}(y)
\]

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $F(y)$
\end_inset

 is the unknown d.f.
\begin_inset VSpace smallskip
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $F_{0}(y)$
\end_inset

 is the d.f.
 from 
\begin_inset Formula $P_{0}$
\end_inset


\begin_inset VSpace smallskip
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $F_{n}(y)=\frac{1}{n}\sum1_{y_{i}\leq y}$
\end_inset

 is the empirical d.f.
\begin_inset VSpace bigskip
\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
\begin_inset Formula $F(\cdot)$
\end_inset

 is 
\series bold
\color blue
discrete with probability one
\series default
\color inherit
 in the DP posterior.
\begin_inset VSpace smallskip
\end_inset


\end_layout

\begin_layout Itemize

\series bold
\color blue
Realisations from a DP are discrete with probability one
\series default
\color inherit
.
 
\end_layout


\begin_layout Itemize
A random probability measure 
\begin_inset Formula $P$
\end_inset

 follows a 
\series bold
\color blue
Dirichlet process
\series default
\color inherit
 
\begin_inset Formula $P\sim\mathrm{DP}(\alpha_{0}\cdot P_{0})$
\end_inset

 with 
\series bold
\color blue
base measure
\series default
\color inherit
 
\begin_inset Formula $P_{0}$
\end_inset

 iff 
\begin_inset Formula 
\[
(P(B_{1}),...,P(B_{k}))\sim\mathrm{Dirichlet}(\alpha_{0}P_{0}(B_{1}),...,\alpha_{0}P_{0}(B_{k}))
\]

\end_inset

for any finite measureable partition 
\begin_inset Formula $B_{1},...,B_{k}$
\end_inset

.
